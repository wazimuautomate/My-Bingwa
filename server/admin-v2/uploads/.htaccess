# Uploaded billboard images live here. Serve images, but NEVER execute anything.
# Random filenames + server-side re-encoding + this rule prevent uploaded-code execution.
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
AddType text/plain .php .php3 .php4 .php5 .phtml .pht .phar .cgi .pl .py .sh
Options -ExecCGI -Indexes
<FilesMatch "\.(?i:jpg|jpeg|png|webp|gif)$">
    Require all granted
</FilesMatch>
<FilesMatch "\.(?i:php|php3|php4|php5|phtml|pht|phar|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>
