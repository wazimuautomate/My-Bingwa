<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      READ_PHONE_STATE is requested only when the user taps "open M-Pesa" for an
      offline payment, so the STK USSD can run on the SIM whose number the user
      declared as theirs (not always SIM 1). Best-effort; the app falls back to
      the default SIM if the permission is denied or the SIM number is unavailable.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
      RECEIVE_SMS powers optional Safaricom bundle-delivery / low-balance
      detection only (SmsDeliveryReceiver reads carrier messages locally to
      confirm delivery honestly and suggest top-ups). It is a Google Play
      restricted permission and must be excluded from the Play build variant;
      it is kept here for the direct-APK build. No SMS content leaves the device.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
      REQUEST_INSTALL_PACKAGES lets the direct (GitHub/sideload) channel install a
      newer, same-signing-identity APK in-app via the system package installer
      (core/update/AppUpdateInstaller.kt), instead of dumping the user into a
      browser. On Android 8+ the user still grants a per-app "install unknown apps"
      permission first. Google Play distribution updates itself natively, so this is
      harmless there. An in-place update preserves all local data (same applicationId
      + signing key + higher versionCode).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      RECEIVE_SMS implies telephony hardware; declare it optional so the app
      still installs on non-telephony devices (tablets / ChromeOS) and to satisfy
      lint (PermissionImpliesUnsupportedChromeOsHardware). SMS detection simply
      stays inactive where there is no telephony.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".MyBingwaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyBingwa.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyBingwa.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Serves the downloaded update APK to the system package installer via a
          content:// URI (file:// URIs are blocked on Android 7+). Authority is
          ${applicationId}.updateprovider so debug (.debug suffix) and release keep
          distinct authorities and can coexist. Not exported; access is granted
          per-intent with FLAG_GRANT_READ_URI_PERMISSION. @xml/file_paths exposes
          only the private updates/ directory.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Listens for incoming Safaricom SMS to detect bundle delivery and
          low-balance nudges. Protected by BROADCAST_SMS so only the system can
          deliver the broadcast. Reads message text locally; never logs or
          forwards full numbers or bodies (CLAUDE.md §10).
        -->
        <receiver
            android:name=".notifications.SmsDeliveryReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
