# Normalise text to LF in the repository.
* text=auto eol=lf

# Gradle wrapper script MUST stay LF or CI shells fail with "bad interpreter".
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts stay CRLF.
gradlew.bat text eol=crlf
*.bat text eol=crlf

# Binary assets — never normalise.
*.jar binary
*.png binary
*.webp binary
*.ico binary
*.jpg binary
*.jpeg binary
*.keystore binary
*.jks binary
