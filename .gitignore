# === My Bingwa root .gitignore ===
# Protects build output, secrets, keystores, local machine state and IDE files
# across the whole repository. Module-level .gitignore files also apply.

# --- Secrets & signing (NEVER COMMIT) ---
# Debug builds use AGP's auto-generated ~/.android/debug.keystore, never a committed one.
*.jks
*.keystore
*.p12
*.pem
*.der
*.key
google-services.json
google-services*.json
GoogleService-Info.plist
service-account*.json
play-service-account*.json
*.env
.env
.env.*
!.env.example
secrets.properties
keystore.properties
signing.properties

# --- Gradle ---
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/
build-cache/

# --- Android / SDK local config ---
local.properties
*.iml
.cxx/
.externalNativeBuild/
captures/
output.json
*.apk
*.aab
*.ap_
*.dex
*.class
mapping.txt

# --- Kotlin ---
.kotlin/

# --- IDE (Android Studio / IntelliJ / VS Code) ---
.idea/
.vscode/
*.swp
*~

# --- Firebase / tooling logs ---
*firebase-debug.log*
*firebase-debug.*.log*
.firebase/
firestore-debug.log
ui-debug.log

# --- OS / misc ---
.DS_Store
Thumbs.db
desktop.ini
*.log
